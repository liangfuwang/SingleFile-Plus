{
  "manifest_version": 3,
  "name": "帖子单文件保存器",
  "version": "1.3.0",
  "description": "把网页保存为单文件 HTML：图片 base64 内嵌、离线可看、点击放大。支持论坛静态抓取与飞书/Notion/知识星球等 SPA 的渲染抓取，并可自动识别。",
  "permissions": ["downloads", "tabs", "scripting", "declarativeNetRequest", "offscreen", "storage"],
  "background": { "service_worker": "background.js" },
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "保存帖子为单文件 HTML",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
